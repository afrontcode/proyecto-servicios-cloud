{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComandosSoloEnInstanciasDelProyecto",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-2:<ID_DE_CUENTA>:instance/*",
      "Condition": {
        "StringEquals": { "ssm:resourceTag/Project": "finops-demo" }
      }
    },
    {
      "Sid": "DocumentoDeShell",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-2::document/AWS-RunShellScript"
    },
    {
      "Sid": "LeerResultadosYSesiones",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "ssm:DescribeInstanceInformation",
        "ssm:StartSession",
        "ssm:TerminateSession",
        "ssm:DescribeSessions"
      ],
      "Resource": "*"
    }
  ]
}
